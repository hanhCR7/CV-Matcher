# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# Bắt buộc: API Key của Google Gemini (lấy miễn phí tại https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Tùy chọn: mô hình Gemini sử dụng (mặc định trong code: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tùy chọn: đường dẫn file SQLite lưu dữ liệu (mặc định: cv_matcher.db)
CV_MATCHER_DB=cv_matcher.db

# Tùy chọn: OCR cho PDF ảnh quét và file ảnh, dùng thêm một lượt gọi Gemini cho mỗi file như vậy
# (mặc định: true; đặt false để tắt)
ENABLE_OCR=true
